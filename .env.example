APP_NAME="Zero-Knowledge Password Manager"
# In production you MUST set APP_ENV=production and APP_DEBUG=false
# (a true APP_DEBUG in production exposes stack traces and .env contents).
APP_ENV=local
APP_KEY=
# In production this MUST be false.
APP_DEBUG=true
# In production this MUST be your public HTTPS origin, e.g. https://vault.example.com
APP_URL=http://localhost

# Set this to your previous APP_KEY value(s) when rotating keys in production.
# APP_PREVIOUS_KEYS=

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# Use a production-appropriate level (warning or error), not debug, in production.
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=passwordmanager
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# In production this MUST be true so the session cookie is only sent over HTTPS.
SESSION_SECURE_COOKIE=false
SESSION_EXPIRE_ON_CLOSE=false
# SESSION_SAME_SITE=lax  (default)

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
# Any SMTP provider works; Brevo is shown as an example. Get these from
# your provider's SMTP dashboard.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your-brevo-smtp-login
MAIL_PASSWORD=your-brevo-smtp-key
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Third-party services -----------------------------------------------
# Breach detection (Pwned Passwords) is performed CLIENT-SIDE via the
# k-Anonymity API (api.pwnedpasswords.com) and requires NO API key — the
# CSP already allows the connection. Nothing to configure here.
#
# GeoIP lookup for the "sessions" screen is intentionally NOT wired up:
# session location shows "unknown" until a provider is chosen. Two options:
#   GEOIP_DRIVER=ipinfo  GEOIP_TOKEN=your-token
#   GEOIP_DRIVER=maxmind GEOIP_DATABASE=/path/to/GeoLite2-City.mmdb
# The SessionManager reads location from these only once a provider lands;
# until then `location` stays null (open item in docs/ARCHITECTURE.md).

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
